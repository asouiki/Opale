                        'manDays'        => $s['manDays'],
                        // Jours/homme pilotés par la grille de la page Capacité (qui fait foi) → lecture seule.
                        'manDaysFromCapacity' => (bool) $s['manDaysFromCapacity'],
                        'businessDays'   => (float) $s['businessDays'],
                        // Capacité en points saisie et total SP du sprint, pour le
                        // delta de capacité réactif (carte + tableau).
                        'capacityPoints' => $s['capacityPoints'],
                        'totalSp'        => (float) $s['totalStoryPoints'],
                    ], $sprints),
                    // Indices de `rows` triés chronologiquement et labels associés.
                    'chrono'     => array_values($chronoIndices),
                    'labels'     => array_map(static fn (int $i): string => $sprints[$i]['name'], $chronoIndices),
                    // Page /sprint de chaque point de la courbe (même ordre que labels), ouverte au clic.
