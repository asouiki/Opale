                <!-- Clic sur le point d'un sprint (courbe principale, dataset 0) des graphiques d'évolution : ouvre sa
                     page /sprint dans un nouvel onglet. Les lignes cible / moyenne / médiane ne sont pas cliquables. -->
                <script>
                    window.teamChartSprintLink = function (urls) {
                        const pointAt = (elements) => elements.find(e => e.datasetIndex === 0 && urls[e.index]);
                        return {
                            onClick: (evt, elements) => {
                                const point = pointAt(elements);
                                if (point) window.open(urls[point.index], '_blank', 'noopener');
                            },
                            onHover: (evt, elements) => {
                                evt.native.target.style.cursor = pointAt(elements) ? 'pointer' : 'default';
                            },
                        };
                    };
                </script>

