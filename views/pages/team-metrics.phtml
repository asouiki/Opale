                        'model'      => $aiAnalysis['model'] ?? '',
                        'fromCache'  => $aiAnalysis !== null,
                        'cachedAt'    => $aiAnalysis !== null ? date('d/m/Y à H:i', $aiAnalysis['cached_at']) : '',
                        'extraPrompt' => $aiAnalysis['extraPrompt'] ?? '',
                    ];
                    ?>
                    <script>
                        /**
                         * Composant Alpine de la synthèse IA des métriques d'équipe.
                         * Appelle l'endpoint d'analyse à la demande (sélection de sprints)
                         * et affiche le texte généré. Défini sans defer pour être prêt
                         * avant l'initialisation d'Alpine.
                         *
                         * Une analyse mémorisée (sélection 100 % clôturée) est injectée via
                         * config.analysis pour s'afficher directement au chargement, sans reclic.
                         *
                         * @param {{projectKey:string, sprintIds:string[], analysis:string, model:string, fromCache:boolean, cachedAt:string, extraPrompt:string}} config
                         */
                        window.teamAiAnalysis = function (config) {
                            return {
                                projectKey:  config.projectKey,
                                sprintIds:   config.sprintIds,
                                loading:     false,
                                analysis:    config.analysis || '',
                                error:       '',
                                fromCache:   !!config.fromCache,
                                cachedAt:    config.cachedAt || '',
                                model:       config.model || '',
                                // Indications de la dernière génération : repeuplées pour ne pas perdre le contexte.
                                extraPrompt: config.extraPrompt || '',

                                // Lance la génération. refresh=true ignore le cache (« Régénérer »).
                                run(refresh) {
                                    this.loading = true;
                                    this.error   = '';
                                    const params = new URLSearchParams();
                                    this.sprintIds.forEach(id => params.append('sprintIds[]', id));
                                    if (refresh) {
                                        params.append('refresh', '1');
                                    }
                                    if (this.extraPrompt.trim() !== '') {
                                        params.append('extraPrompt', this.extraPrompt.trim());
                                    }
                                    fetch(
                                        '/api/internal/projects/' + encodeURIComponent(this.projectKey)
                                        + '/team-metrics/analysis',
                                        {
                                            method:  'POST',
                                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                            body:    params.toString()
                                        }
                                    )
                                    .then(r => r.json())
                                    .then(data => {
                                        if (data.error) {
                                            this.error    = data.error;
                                            this.analysis = '';
                                        } else {
                                            this.analysis  = data.analysis || '';
                                            this.fromCache = !!data.fromCache;
                                            this.cachedAt  = '';
                                            this.model     = data.model || '';
                                            // Synthèse servie depuis le cache : on restitue ses indications d'origine.
                                            if (data.fromCache) {
                                                this.extraPrompt = data.extraPrompt || '';
                                            }
                                        }
                                    })
                                    .catch(() => { this.error = 'Impossible de contacter le service IA.'; })
                                    .finally(() => { this.loading = false; });
                                }
                            };
                        };
                    </script>
                    <div class="card ai-synthesis" x-data="teamAiAnalysis(<?= htmlspecialchars(json_encode($aiConfig), ENT_QUOTES) ?>)">
                        <h2>🤖 Synthèse IA des sprints sélectionnés</h2>
                        <p class="ai-synthesis__disclaimer">
                            ⚠️ Générée par une IA <b>locale, fermée et non connectée à Internet</b>, à partir des métriques agrégées — à relire et valider par le Scrum Master.
                        </p>

                        <!-- État initial : champ d'indications libres + bouton de génération -->
                        <div class="ai-synthesis__actions" x-show="!loading && !analysis" x-cloak>
                            <div class="ai-synthesis__extra-field">
                                <label class="ai-synthesis__extra-label" for="team-ai-extra">
                                    Indications supplémentaires (facultatif)
                                </label>
                                <textarea id="team-ai-extra" class="ai-synthesis__extra" x-model="extraPrompt"
                                    rows="3" placeholder="Contexte (absences, changement de ressource…) ou directive d'analyse (focus sur une métrique, angle particulier)…"></textarea>
                            </div>
                            <button type="button" class="ai-synthesis__btn" @click="run(false)">
                                ✨ Générer la synthèse
                            </button>
                        </div>

                        <!-- Loader pendant l'appel au modèle (peut durer plusieurs dizaines de secondes) -->
                        <div class="ai-synthesis__loader" x-show="loading" x-cloak>
                            <span class="ai-synthesis__spinner" aria-hidden="true"></span>
                            <span>⏳ Analyse en cours… le modèle local peut prendre quelques dizaines de secondes.</span>
                        </div>

                        <!-- Erreur -->
                        <div class="ai-synthesis__error" x-show="error && !loading" x-cloak x-text="error"></div>

                        <!-- Synthèse générée -->
                        <div class="ai-synthesis__result" x-show="analysis && !loading" x-cloak>
                            <p class="ai-synthesis__text" x-text="analysis"></p>
                            <div class="ai-synthesis__extra-field">
                                <label class="ai-synthesis__extra-label" for="team-ai-extra-regen">
                                    Indications supplémentaires (facultatif)
                                </label>
                                <textarea id="team-ai-extra-regen" class="ai-synthesis__extra" x-model="extraPrompt"
                                    rows="3" placeholder="Contexte (absences, changement de ressource…) ou directive d'analyse (focus sur une métrique, angle particulier)…"></textarea>
                            </div>
                            <div class="ai-synthesis__meta">
                                <span class="badge grey" x-show="fromCache"
                                    x-text="cachedAt ? ('🗄️ Issu du cache — généré le ' + cachedAt) : '🗄️ Issu du cache'"></span>
                                <span class="ai-synthesis__model" x-text="model ? ('Modèle : ' + model) : ''"></span>
                                <button type="button" class="ai-synthesis__regen" @click="run(true)">🔄 Régénérer</button>
