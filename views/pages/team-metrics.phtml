                $errors  = $view->getErrors();

                // Période couverte : du démarrage le plus ancien à la clôture la
                // plus récente parmi les sprints analysés.
                $starts = array_filter(array_column($sprints, 'startDate'));
                $ends   = array_filter(array_map(
                    static fn (array $s): ?string => $s['completeDate'] ?: $s['endDate'],
                    $sprints
                ));
                $periodStart = $starts ? min($starts) : null;
                $periodEnd   = $ends ? max($ends) : null;

                // Ordre chronologique des sprints (indices de $sprints triés du plus
                // ancien au plus récent), pour tracer la courbe de vélocité dans
                // l'ordre du temps comme les autres graphes d'évolution.
                $chronoIndices = array_keys($sprints);
                usort($chronoIndices, static function (int $a, int $b) use ($sprints): int {
                    $keyA = $sprints[$a]['completeDate'] ?: ($sprints[$a]['endDate'] ?: '');
                    $keyB = $sprints[$b]['completeDate'] ?: ($sprints[$b]['endDate'] ?: '');
                    return strcmp((string) $keyA, (string) $keyB);
                });

                // État initial du composant Alpine de saisie jours/homme : une
                // entrée par sprint (id, SP terminés, jours/homme déjà saisis), plus
                // l'ordre et les libellés chronologiques pour la courbe de vélocité.
