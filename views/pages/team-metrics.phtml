                <script>
                    /**
                     * Composant Alpine de saisie des jours/homme par sprint.
                     * Calcule en direct la vélocité SP/jours-homme (par ligne et agrégée),
                     * persiste chaque saisie via l'API (debounce) et alimente la courbe
                     * d'évolution de la vélocité (mise à jour en direct à chaque saisie),
                     * sans recharger la page.
                     *
                     * @param {{projectKey:string, rows:Array<{id:string,doneSp:number,manDays:?number}>, chrono:number[], labels:string[], urls:string[]}} config
                     */
                    window.manDaysVelocity = function (config) {
                        // Instance Chart.js conservée HORS de l'état réactif Alpine : Alpine
                        // encapsule les propriétés de données dans un Proxy, or Chart.js v4
                        // utilise des champs privés (#) inaccessibles via Proxy — ce qui
                        // casserait chart.update(). On la garde donc en variable de closure.
                        let velocityChart = null;

                        return {
                            projectKey: config.projectKey,
                            rows: config.rows,
                            // Ordre et libellés chronologiques pour la courbe de vélocité.
                            chrono: config.chrono,
                            labels: config.labels,
                            // Page /sprint de chaque point (même ordre que labels), ouverte au clic sur le point.
                            urls: config.urls,
                            timers: {},
                            capacityTimers: {},

                            // Calcul affiché par le graphe d'évolution (switch de la carte).
                            velocityMetric: 'spPerManDay',
                            // Calculs disponibles : libellé du bouton/série, unité (pour la
                            // moyenne) et titre de l'axe Y.
                            metricDefs: {
                                spPerManDay:  { label: 'Points terminés par jours/homme', unit: 'SP/j-h',  y: 'SP / jour-homme' },
                                spPerDay:     { label: 'Points terminés par jour ouvré',  unit: 'SP/j',    y: 'SP / jour ouvré' },
                                manDaysPerSp: { label: 'Jours pour 1 SP par jours/homme', unit: 'j-h/SP',  y: 'jours-homme / SP' },
                                daysPerSp:    { label: 'Jours pour 1 SP par jour ouvré',  unit: 'j/SP',    y: 'jours ouvrés / SP' },
                                spPerPerson:  { label: 'SP terminés par personne',        unit: 'SP/pers', y: 'SP / personne' },
                            },

                            // Crée le graphe au démarrage du composant. Les mises à jour en
                            // direct sont déclenchées depuis save(i), appelé à chaque saisie.
                            init() {
                                this.initVelocityChart();
                            },

                            // Bascule le calcul affiché par le graphe puis le redessine.
                            setVelocityMetric(key) {
                                this.velocityMetric = key;
                                this.refreshVelocityChart();
                            },

                            // Valeur d'une ligne pour un calcul donné (null si donnée requise
                            // absente : la courbe laisse alors un vide sur ce sprint).
                            rowMetricFor(i, metric) {
                                const r = this.rows[i];
                                const md = parseFloat(r.manDays);
                                const bd = r.businessDays;
                                const sp = r.doneSp;
                                switch (metric) {
                                    case 'spPerManDay':  return md > 0 ? Math.round((sp / md) * 100) / 100 : null;
                                    case 'spPerDay':     return bd > 0 ? Math.round((sp / bd) * 100) / 100 : null;
                                    case 'manDaysPerSp': return (md > 0 && sp > 0) ? Math.round((md / sp) * 100) / 100 : null;
                                    case 'daysPerSp':    return (bd > 0 && sp > 0) ? Math.round((bd / sp) * 100) / 100 : null;
                                    case 'spPerPerson':  return (md > 0 && bd > 0) ? Math.round(((sp * bd) / md) * 100) / 100 : null;
                                }
                                return null;
                            },

                            // Valeur d'une ligne pour le calcul courant (délègue à rowMetricFor).
                            rowMetric(i) {
                                return this.rowMetricFor(i, this.velocityMetric);
                            },

                            // Médiane des valeurs d'un calcul sur les sprints sélectionnés.
                            // Les sprints sans la donnée requise (null) sont exclus ; null si
                            // aucune valeur exploitable.
                            medianOf(metric) {
                                const values = this.rows
                                    .map((_, i) => this.rowMetricFor(i, metric))
                                    .filter((v) => v !== null)
                                    .sort((a, b) => a - b);
                                if (values.length === 0) return null;
                                const mid = Math.floor(values.length / 2);
                                // Nombre pair : moyenne des deux valeurs centrales ; impair : centrale.
                                const med = values.length % 2 === 0
                                    ? (values[mid - 1] + values[mid]) / 2
                                    : values[mid];
                                return Math.round(med * 100) / 100;
                            },

                            // Médiane du calcul actuellement affiché par le graphe.
                            medianMetric() {
                                return this.medianOf(this.velocityMetric);
                            },

                            // Moyenne agrégée du calcul courant (réutilise les agrégats des
                            // cartes pour rester cohérent ; null si donnée insuffisante).
                            aggregateMetric() {
                                switch (this.velocityMetric) {
                                    case 'spPerManDay':  return this.aggregateVelocity();
                                    case 'manDaysPerSp': return this.aggregateManDaysPerSp();
                                    case 'spPerPerson':  return this.aggregateSpPerPerson();
                                    case 'spPerDay':
                                    case 'daysPerSp': {
                                        let sp = 0, bd = 0;
                                        for (const r of this.rows) {
                                            if (r.businessDays > 0) { sp += r.doneSp; bd += r.businessDays; }
                                        }
                                        if (this.velocityMetric === 'spPerDay') {
                                            return bd > 0 ? Math.round((sp / bd) * 100) / 100 : null;
                                        }
                                        return sp > 0 ? Math.round((bd / sp) * 100) / 100 : null;
                                    }
                                }
                                return null;
                            },

                            // Série du calcul courant en ordre chronologique.
                            velocitySeries() {
                                return this.chrono.map((i) => this.rowMetric(i));
                            },

                            // Libellé de la ligne de moyenne, valeur et unité incluses ;
                            // « Moyenne » seul tant que la valeur est indéfinie.
                            velocityAvgLabel() {
                                const v = this.aggregateMetric();
                                return v === null
                                    ? 'Moyenne'
                                    : 'Moyenne (' + v + ' ' + this.metricDefs[this.velocityMetric].unit + ')';
                            },

                            // Libellé de la ligne médiane, valeur et unité incluses ;
                            // « Médiane » seul tant que la valeur est indéfinie.
                            velocityMedianLabel() {
                                const v = this.medianMetric();
                                return v === null
                                    ? 'Médiane'
                                    : 'Médiane (' + v + ' ' + this.metricDefs[this.velocityMetric].unit + ')';
                            },

                            // Construit la courbe d'évolution : vélocité par sprint + ligne
                            // horizontale de la vélocité moyenne agrégée.
                            initVelocityChart() {
                                const def = this.metricDefs[this.velocityMetric];
                                const ctx = document.getElementById('velocityChart').getContext('2d');
                                velocityChart = new Chart(ctx, {
                                    type: 'line',
                                    data: {
                                        labels: this.labels,
                                        datasets: [
                                            {
                                                label: def.label,
                                                data: this.velocitySeries(),
                                                borderColor: '#2563eb',
                                                backgroundColor: '#2563eb22',
                                                pointBackgroundColor: '#2563eb',
                                                pointRadius: 5,
                                                pointHoverRadius: 7,
                                                tension: 0.25,
                                                spanGaps: true, // relie par-dessus les sprints sans saisie
                                                fill: true
                                            },
                                            {
                                                // Vélocité moyenne agrégée (recalculée en direct).
                                                label: this.velocityAvgLabel(),
                                                data: this.labels.map(() => this.aggregateVelocity()),
                                                borderColor: '#10b981',
                                                borderWidth: 2,
                                                pointRadius: 0,
                                                fill: false
                                            },
                                            {
                                                // Médiane du calcul courant (barre horizontale, recalculée en direct).
                                                label: this.velocityMedianLabel(),
                                                data: this.labels.map(() => this.medianMetric()),
                                                borderColor: '#f59e0b',
                                                borderWidth: 2,
                                                borderDash: [6, 4],
                                                pointRadius: 0,
                                                fill: false
                                            }
                                        ]
                                    },
                                    options: {
                                        responsive: true,
                                        maintainAspectRatio: false,
                                        ...window.teamChartSprintLink(this.urls),
                                        plugins: {
                                            legend: { display: true },
                                            tooltip: {
                                                callbacks: {
                                                    // Titre = nom du sprint (label X) ; corps = vélocité.
                                                    label: (c) => c.dataset.label + ' : ' + c.parsed.y
                                                }
                                            }
                                        },
                                        scales: {
                                            y: {
                                                beginAtZero: true,
                                                title: { display: true, text: def.y }
                                            },
                                            x: {
                                                title: { display: true, text: 'Sprint' }
                                            }
                                        }
                                    }
                                });
                            },

                            // Réinjecte les séries recalculées (vélocités + moyenne) dans le
                            // graphe et le redessine. Appelé à chaque saisie de jours/homme.
                            refreshVelocityChart() {
                                if (!velocityChart) return;
                                const def = this.metricDefs[this.velocityMetric];
                                velocityChart.data.datasets[0].data = this.velocitySeries();
                                velocityChart.data.datasets[0].label = def.label;
                                velocityChart.data.datasets[1].data = this.labels.map(() => this.aggregateMetric());
                                velocityChart.data.datasets[1].label = this.velocityAvgLabel();
                                velocityChart.data.datasets[2].data = this.labels.map(() => this.medianMetric());
                                velocityChart.data.datasets[2].label = this.velocityMedianLabel();
                                velocityChart.options.scales.y.title.text = def.y;
                                velocityChart.update();
                            },

                            // Vélocité d'une ligne : SP terminés / jours-homme (null si non saisi).
                            rowVelocity(i) {
                                const md = parseFloat(this.rows[i].manDays);
                                if (!md || md <= 0) return null;
                                return Math.round((this.rows[i].doneSp / md) * 100) / 100;
                            },

                            // Inverse d'une ligne : jours-homme pour terminer 1 SP (jours-homme /
                            // SP terminés). Null si jours-homme non saisi ou aucun SP terminé.
                            rowManDaysPerSp(i) {
                                const md = parseFloat(this.rows[i].manDays);
                                if (!md || md <= 0 || this.rows[i].doneSp <= 0) return null;
                                return Math.round((md / this.rows[i].doneSp) * 100) / 100;
                            },

                            // Vélocité agrégée : Σ SP / Σ jours-homme, sur les seuls sprints saisis.
                            aggregateVelocity() {
                                let sp = 0, md = 0;
                                for (const r of this.rows) {
                                    const v = parseFloat(r.manDays);
                                    if (v && v > 0) { sp += r.doneSp; md += v; }
                                }
                                return md > 0 ? Math.round((sp / md) * 100) / 100 : null;
                            },

                            // Inverse de la vélocité jours-homme : Σ jours-homme / Σ SP terminés,
                            // sur les seuls sprints saisis (null si aucune saisie ou aucun SP).
                            aggregateManDaysPerSp() {
                                let sp = 0, md = 0;
                                for (const r of this.rows) {
                                    const v = parseFloat(r.manDays);
                                    if (v && v > 0) { sp += r.doneSp; md += v; }
                                }
                                return sp > 0 ? Math.round((md / sp) * 100) / 100 : null;
                            },

                            // SP par personne et par sprint (moyenne ; effectif moyen estimé
                            // = jours-homme / jours ouvrés, donc SP × jours ouvrés / jours-homme).
                            // Moyenne sur les seuls sprints saisis (null si aucun).
                            aggregateSpPerPerson() {
                                let sum = 0, n = 0;
                                for (const r of this.rows) {
                                    const v = parseFloat(r.manDays);
                                    if (v && v > 0 && r.businessDays > 0) {
                                        sum += (r.doneSp * r.businessDays) / v;
                                        n++;
                                    }
                                }
                                return n > 0 ? Math.round((sum / n) * 100) / 100 : null;
                            },

                            // Jours-homme saisis (> 0), pour la moyenne et la fourchette.
                            manDaysList() {
                                return this.rows
                                    .map((r) => parseFloat(r.manDays))
                                    .filter((v) => v && v > 0);
                            },

                            // Moyenne des jours-homme saisis (null si aucune saisie).
                            aggregateManDaysAvg() {
                                const list = this.manDaysList();
                                if (list.length === 0) return null;
                                const sum = list.reduce((a, b) => a + b, 0);
                                return Math.round((sum / list.length) * 10) / 10;
                            },

                            // Jours-homme minimum saisi (null si aucune saisie).
                            manDaysMin() {
                                const list = this.manDaysList();
                                return list.length ? Math.round(Math.min(...list) * 10) / 10 : null;
                            },

                            // Jours-homme maximum saisi (null si aucune saisie).
                            manDaysMax() {
                                const list = this.manDaysList();
                                return list.length ? Math.round(Math.max(...list) * 10) / 10 : null;
                            },

                            // Total des jours-homme saisis (pied de tableau).
                            totalManDays() {
                                let md = 0;
                                for (const r of this.rows) {
                                    const v = parseFloat(r.manDays);
                                    if (v && v > 0) md += v;
                                }
                                return md > 0 ? Math.round(md * 10) / 10 : null;
                            },

                            // Affichage : tiret si null/indéfini, sinon la valeur telle quelle.
                            fmt(value) {
                                return (value === null || value === undefined || value === '') ? '—' : String(value);
                            },

                            // Affichage d'un écart signé : tiret si null, « + » explicite si positif.
                            fmtDelta(value) {
                                if (value === null || value === undefined || value === '') return '—';
                                return value > 0 ? '+' + value : String(value);
                            },

                            // Capacités en points saisies (> 0), pour la moyenne et le delta.
                            capacityList() {
                                return this.rows
                                    .map((r) => parseFloat(r.capacityPoints))
                                    .filter((v) => v && v > 0);
                            },

                            // Capacité moyenne saisie (null si aucune saisie) — pied de tableau.
                            avgCapacityPoints() {
                                const list = this.capacityList();
                                if (list.length === 0) return null;
                                const sum = list.reduce((a, b) => a + b, 0);
                                return Math.round((sum / list.length) * 10) / 10;
                            },

                            // Delta moyen (total SP − capacité) sur les seuls sprints avec
                            // une capacité saisie (> 0). Null si aucun.
                            avgCapacityDelta() {
                                let sum = 0, n = 0;
                                for (const r of this.rows) {
                                    const cap = parseFloat(r.capacityPoints);
                                    if (cap && cap > 0) {
                                        sum += (r.totalSp - cap);
                                        n++;
                                    }
                                }
                                return n > 0 ? Math.round((sum / n) * 10) / 10 : null;
                            },

                            // Icône d'état du delta moyen : au-dessus (rouge), égal (orange),
                            // en-dessous (vert). Chaîne vide si aucune capacité saisie.
                            capacityDeltaIcon() {
                                const d = this.avgCapacityDelta();
                                if (d === null) return '';
                                return d > 0 ? '🔴' : (d < 0 ? '🟢' : '🟠');
                            },

                            // Persiste la saisie d'une ligne (debounce 700ms) ; vide/<=0 => effacement.
                            // Corps en urlencoded : l'app ne parse pas le JSON (pas de BodyParsingMiddleware).
                            save(i) {
                                const row = this.rows[i];
                                // Jours/homme pilotés par la page Capacité : champ verrouillé, aucune écriture.
                                if (row.manDaysFromCapacity) return;
                                // Mise à jour immédiate de la courbe (hors debounce de l'API).
                                this.refreshVelocityChart();
                                clearTimeout(this.timers[i]);
                                this.timers[i] = setTimeout(() => {
                                    const raw = row.manDays;
                                    const manDays = (raw === '' || raw === null || parseFloat(raw) <= 0)
                                        ? '' : parseFloat(raw);
                                    fetch(
                                        '/api/internal/projects/' + encodeURIComponent(this.projectKey)
                                        + '/sprints/' + encodeURIComponent(row.id) + '/man-days',
                                        {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                            body: 'manDays=' + encodeURIComponent(manDays)
                                        }
                                    ).catch(() => {});
                                }, 700);
                            },

                            // Persiste la capacité en points d'une ligne (debounce 700ms) ;
                            // vide/<=0 => effacement. Le delta moyen de capacité se met à
                            // jour en direct (x-text), sans recharger la page.
                            saveCapacity(i) {
                                const row = this.rows[i];
                                clearTimeout(this.capacityTimers[i]);
                                this.capacityTimers[i] = setTimeout(() => {
                                    const raw = row.capacityPoints;
                                    const value = (raw === '' || raw === null || parseFloat(raw) <= 0)
                                        ? '' : parseFloat(raw);
                                    fetch(
                                        '/api/internal/projects/' + encodeURIComponent(this.projectKey)
                                        + '/sprints/' + encodeURIComponent(row.id) + '/capacity-points',
                                        {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                            body: 'capacityPoints=' + encodeURIComponent(value)
                                        }
                                    ).catch(() => {});
                                }, 700);
                            }
                        };
                    };
                </script>
            <?php endif; ?>
        </div>

