            <script>
                /**
                 * Composant Alpine de la synthèse IA du sprint.
                 * Appelle l'endpoint d'analyse à la demande et affiche le texte généré.
                 * Défini sans defer pour être prêt avant l'initialisation d'Alpine.
                 *
                 * Une analyse mémorisée est injectée via config.analysis pour s'afficher directement
                 * au chargement, sans reclic sur « Générer ». config.isClosed distingue le badge de
                 * fraîcheur : sprint clôturé (analyse figée) ou en cours (photo datée à régénérer).
                 *
                 * @param {{projectKey:string, sprintId:string, boardId:string, analysis:string, model:string, fromCache:boolean, cachedAt:string, isClosed:boolean, extraPrompt:string}} config
                 */
                window.sprintAiAnalysis = function (config) {
                    return {
                        projectKey:  config.projectKey,
                        sprintId:    config.sprintId,
                        boardId:     config.boardId,
                        loading:     false,
                        analysis:    config.analysis || '',
                        error:       '',
                        fromCache:   !!config.fromCache,
                        cachedAt:    config.cachedAt || '',
                        isClosed:    !!config.isClosed,
                        model:       config.model || '',
                        // Indications de la dernière génération : repeuplées pour ne pas perdre le contexte.
                        extraPrompt: config.extraPrompt || '',

                        // Libellé du badge de cache : un sprint en cours continue d'évoluer après la
                        // génération, l'analyse mémorisée n'est donc qu'une photo datée.
                        cacheBadgeLabel() {
                            if (!this.cachedAt) {
                                return '🗄️ Issu du cache';
                            }
                            return this.isClosed
                                ? '🗄️ Issu du cache — généré le ' + this.cachedAt
                                : '⚠️ Basée sur l\'état du ' + this.cachedAt + ' — sprint encore en cours, pense à régénérer';
                        },

                        // Lance la génération. refresh=true ignore le cache (bouton « Régénérer »).
                        run(refresh) {
                            this.loading = true;
                            this.error   = '';
                            let body = 'boardId=' + encodeURIComponent(this.boardId)
                                + (refresh ? '&refresh=1' : '');
                            if (this.extraPrompt.trim() !== '') {
                                body += '&extraPrompt=' + encodeURIComponent(this.extraPrompt.trim());
                            }
                            fetch(
                                '/api/internal/projects/' + encodeURIComponent(this.projectKey)
                                + '/sprints/' + encodeURIComponent(this.sprintId) + '/analysis',
                                {
                                    method:  'POST',
                                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                    body:    body
                                }
                            )
                            .then(r => r.json())
                            .then(data => {
                                if (data.error) {
                                    this.error    = data.error;
                                    this.analysis = '';
                                } else {
                                    this.analysis  = data.analysis || '';
                                    this.fromCache = !!data.fromCache;
                                    this.cachedAt  = '';
                                    this.model     = data.model || '';
                                    // Synthèse servie depuis le cache : on restitue ses indications d'origine.
                                    if (data.fromCache) {
                                        this.extraPrompt = data.extraPrompt || '';
                                    }
                                }
                            })
                            .catch(() => { this.error = 'Impossible de contacter le service IA.'; })
                            .finally(() => { this.loading = false; });
                        }
                    };
                };
            </script>
