    <script>
        /**
         * Composant Alpine de saisie des jours/homme d'un sprint.
         * Défini dans <head> (sans defer) pour être disponible avant qu'Alpine
         * initialise le x-data correspondant plus bas dans la page.
         *
         * @param {{projectKey:string, sprintId:string, doneSp:number, businessDays:number, manDays:?number, capacityPoints:?number}} config
         */
        window.sprintManDays = function (config) {
            return {
                projectKey:     config.projectKey,
                sprintId:       config.sprintId,
                doneSp:         config.doneSp,
                businessDays:   config.businessDays,
                manDays:        config.manDays,
                // Jours/homme pilotés par la grille de l'onglet Capacité (qui fait foi) : champ verrouillé,
                // toute saisie manuelle serait de toute façon ignorée à la lecture.
                manDaysReadOnly: config.manDaysReadOnly,
                capacityPoints: config.capacityPoints,
                timer:          null,
                capacityTimer:  null,

                // Vélocité du sprint (iso carte « Vélocité » des Métriques d'équipe).
                // Les calculs « par jours/homme » sont réactifs à la saisie ; ceux
                // « par jour ouvré » dérivent des jours ouvrés du sprint (fixes).
                // SP terminés par jours/homme.
                spPerManDay() {
                    const md = parseFloat(this.manDays);
                    return (md > 0) ? Math.round((this.doneSp / md) * 100) / 100 : null;
                },
                // SP terminés par jour ouvré.
                spPerDay() {
                    const bd = this.businessDays;
                    return (bd > 0) ? Math.round((this.doneSp / bd) * 100) / 100 : null;
                },
                // Jours/homme pour terminer 1 SP.
                manDaysPerSp() {
                    const md = parseFloat(this.manDays);
                    return (md > 0 && this.doneSp > 0) ? Math.round((md / this.doneSp) * 100) / 100 : null;
                },
                // Jours ouvrés pour terminer 1 SP.
                daysPerSp() {
                    const bd = this.businessDays;
                    return (bd > 0 && this.doneSp > 0) ? Math.round((bd / this.doneSp) * 100) / 100 : null;
                },
                // SP terminés par personne (effectif estimé = jours-homme / jours ouvrés).
                spPerPerson() {
                    const md = parseFloat(this.manDays);
                    const bd = this.businessDays;
                    return (md > 0 && bd > 0) ? Math.round(((this.doneSp * bd) / md) * 100) / 100 : null;
                },

                fmt(value) {
                    return (value === null || value === undefined || value === '') ? '—' : String(value);
                },

                // Persiste les jours/homme (debounce 700ms) ; vide/<=0 => effacement.
                // Corps en urlencoded : l'app ne parse pas le JSON.
                save() {
                    if (this.manDaysReadOnly) return;
                    clearTimeout(this.timer);
                    this.timer = setTimeout(() => {
                        const raw     = this.manDays;
                        const manDays = (raw === '' || raw === null || parseFloat(raw) <= 0)
                            ? '' : parseFloat(raw);
                        fetch(
                            '/api/internal/projects/' + encodeURIComponent(this.projectKey)
                            + '/sprints/' + encodeURIComponent(this.sprintId) + '/man-days',
                            {
                                method:  'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body:    'manDays=' + encodeURIComponent(manDays)
                            }
                        ).catch(() => {});
                    }, 700);
                },

                // Persiste la capacité en points (debounce 700ms) ; vide/<=0 => effacement.
                saveCapacity() {
                    clearTimeout(this.capacityTimer);
                    this.capacityTimer = setTimeout(() => {
                        const raw   = this.capacityPoints;
                        const value = (raw === '' || raw === null || parseFloat(raw) <= 0)
                            ? '' : parseFloat(raw);
                        fetch(
                            '/api/internal/projects/' + encodeURIComponent(this.projectKey)
                            + '/sprints/' + encodeURIComponent(this.sprintId) + '/capacity-points',
                            {
                                method:  'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body:    'capacityPoints=' + encodeURIComponent(value)
                            }
                        ).catch(() => {});
                    }, 700);
                }
            };
        };
    </script>
