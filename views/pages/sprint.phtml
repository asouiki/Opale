            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <!-- Plugin d'étiquettes DANS les parts (libellé + %). Chargé après Chart.js. -->
            <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
            <script>
                (function() {
                    // Statuts NON vides (état initial) + TOUS les statuts (toggle).
                    const rowsNonEmpty = <?= json_encode($landingChartData, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
                    const rowsAll      = <?= json_encode($landingAllChartData, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

                    // Libellé + suffixe d'unité par métrique (pour titre et tooltip).
                    const metrics = {
                        count:       { label: 'Nb de tickets', unit: ' tickets' },
                        totalDays:   { label: 'Temps passé total', unit: ' j ouvrés' },
                        storyPoints: { label: 'Story Points', unit: ' SP' },
                    };

                    let metric      = 'count';
                    let activeRows  = rowsNonEmpty; // mis à jour par rebuildChart()

                    // Arrondit à 1 décimale et supprime un « .0 » superflu.
                    const fmt = (v) => {
                        const r = Math.round(v * 10) / 10;
                        return Number.isInteger(r) ? String(r) : r.toFixed(1);
                    };

                    const ctx = document.getElementById('landingPieChart').getContext('2d');
                    const chart = new Chart(ctx, {
                        type: 'pie',
                        // Plugin enregistré localement : n'affecte que ce graphique.
                        plugins: [ChartDataLabels],
                        data: {
                            labels: activeRows.map(r => r.status),
                            datasets: [{
                                data: activeRows.map(r => r[metric]),
                                backgroundColor: activeRows.map(r => r.color),
                                borderColor: '#fff',
                                borderWidth: 2,
                            }],
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                title: { display: true, text: 'Répartition par ' + metrics[metric].label },
                                tooltip: {
                                    callbacks: {
                                        label: (c) => {
                                            const total = c.dataset.data.reduce((a, b) => a + b, 0);
                                            const pct = total > 0 ? Math.round((c.parsed / total) * 1000) / 10 : 0;
                                            return `${c.label} : ${fmt(c.parsed)}${metrics[metric].unit} (${pct} %)`;
                                        },
                                    },
                                },
                                datalabels: {
                                    color: '#fff',
                                    textAlign: 'center',
                                    font: { size: 11, weight: '600' },
                                    display: 'auto',
                                    textStrokeColor: 'rgba(0, 0, 0, 0.45)',
                                    textStrokeWidth: 3,
                                    formatter: (value, c) => {
                                        const total = c.dataset.data.reduce((a, b) => a + b, 0);
                                        const pct = total > 0 ? Math.round((value / total) * 100) : 0;
                                        return [c.chart.data.labels[c.dataIndex], pct + ' %'];
                                    },
                                },
                            },
                        },
                    });

                    // Reconstruit labels/data/couleurs selon le filtre actif.
                    function rebuildChart(showEmpty) {
                        activeRows = showEmpty ? rowsAll : rowsNonEmpty;
                        chart.data.labels                        = activeRows.map(r => r.status);
                        chart.data.datasets[0].data              = activeRows.map(r => r[metric]);
                        chart.data.datasets[0].backgroundColor   = activeRows.map(r => r.color);
                        chart.options.plugins.title.text         = 'Répartition par ' + metrics[metric].label;
                        chart.update();
                    }

                    // Toggle « Afficher les statuts vides » (événement Alpine.js).
                    document.addEventListener('landing-toggle-empty', (e) => {
                        rebuildChart(e.detail.show);
                    });

                    // Switch de métrique : met à jour les valeurs sur activeRows.
                    document.getElementById('landingMetricFilters').addEventListener('click', function(e) {
                        const btn = e.target.closest('button[data-metric]');
                        if (!btn) return;
                        metric = btn.dataset.metric;

                        this.querySelectorAll('.team-filter').forEach((b) =>
                            b.classList.toggle('team-filter--active', b === btn)
                        );

                        chart.data.datasets[0].data      = activeRows.map(r => r[metric]);
                        chart.options.plugins.title.text = 'Répartition par ' + metrics[metric].label;
                        chart.update();
                    });
                })();
            </script>
        <?php endif; ?>

