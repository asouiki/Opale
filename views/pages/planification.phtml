        <script>
            /**
             * Bascule `.is-stuck` sur le bandeau d'aide à la planification dès qu'il devient
             * réellement collé en haut de la fenêtre, pour en compacter l'affichage (titre et notice
             * masqués, essentiels sur une seule ligne — cf. planification.css).
             *
             * `position: sticky` n'expose aucun état « collé » en CSS pur : on le déduit via une
             * sentinelle invisible juste avant le bandeau — tant qu'elle est visible, le bandeau est
             * encore à sa place naturelle ; dès qu'elle sort du haut de la fenêtre, il est collé.
             * Scoped à cette page (et non au script générique `stickyBarScript.phtml`, partagé avec
             * /sprint) : seule /planification a besoin de ce rendu compact.
             */
            (function () {
                var bar = document.querySelector('.planif-summary');
                var sentinel = document.querySelector('.planif-summary__sentinel');
                if (!bar || !sentinel || typeof IntersectionObserver === 'undefined') {
                    return;
                }

                new IntersectionObserver(function(entries) {
                    bar.classList.toggle('is-stuck', !entries[0].isIntersecting);
                }, { threshold: 0 }).observe(sentinel);
            })();
        </script>

