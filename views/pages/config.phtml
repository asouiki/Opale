    <script>
        (function() {
            /**
             * Composant Alpine de sélection des métriques préférées (pages Sprint et
             * Métriques d'équipe). La sélection est persistée dans le localStorage via
             * window.MetricPrefs (préférence personnelle, jamais côté serveur).
             */
            window.metricPrefsConfig = function() {
                return {
                    // Pages couvertes par la sélection de métriques préférées.
                    pages: [
                        { page: 'sprint', title: '🛠️ Page Analyse du Sprint' },
                        { page: 'team_metrics', title: '📊 Page Métriques d\'équipe' },
                    ],
                    // Sélection courante par page (liste des id affichés par défaut).
                    selected: { sprint: [], team_metrics: [] },
                    // Indicateur « Enregistré » transitoire par page.
                    saved: { sprint: false, team_metrics: false },

                    /**
                     * Initialise la sélection depuis le localStorage. Sans préférence
                     * enregistrée (primo-accédant), on retombe sur la sélection par défaut
                     * (vue simplifiée : tout coché sauf les métriques marquées `defaultOff`).
                     */
                    init() {
                        this.pages.forEach((p) => {
                            const prefs = window.MetricPrefs.getPrefs(p.page);
                            this.selected[p.page] = prefs === null
                                ? window.MetricPrefs.getDefaultPrefs(p.page)
                                : prefs;
                        });
                    },

                    /** Regroupe le catalogue d'une page par `group` (pour l'affichage). */
                    groups(page) {
                        const result = [];
                        window.MetricPrefs.catalog[page].forEach((item) => {
                            let grp = result.find((g) => g.name === item.group);
                            if (!grp) { grp = { name: item.group, items: [] }; result.push(grp); }
                            grp.items.push(item);
                        });
                        return result;
                    },

                    /** Indique si une métrique est affichée par défaut. */
                    isOn(page, id) {
                        return this.selected[page].includes(id);
                    },

                    /** Coche/décoche une métrique de la page, puis persiste. */
                    toggle(page, id, checked) {
                        if (checked) {
                            if (!this.selected[page].includes(id)) {
                                this.selected[page].push(id);
                            }
                        } else {
                            this.selected[page] = this.selected[page].filter((x) => x !== id);
                        }
                        this.save(page);
                    },

                    /** Coche toutes les métriques de la page, puis persiste. */
                    selectAll(page) {
                        this.selected[page] = window.MetricPrefs.catalog[page].map((e) => e.id);
                        this.save(page);
                    },

                    /** Décoche toutes les métriques de la page, puis persiste. */
                    selectNone(page) {
                        this.selected[page] = [];
                        this.save(page);
                    },

                    /** Persiste la sélection de la page dans le localStorage. */
                    save(page) {
                        window.MetricPrefs.setPrefs(page, this.selected[page]);
                        this.saved[page] = true;
                        setTimeout(() => { this.saved[page] = false; }, 1500);
                    },
                };
            };
        })();
    </script>

    <script>
        (function() {
            const POOL_KEY = 'jira_pool_team';

            window.projectConfig = function() {
                return {
                    // --- Projet ---
                    query: '',
                    open: false,
                    projects: [],
                    selectedProject: null,

                    // --- Board par défaut ---
                    boards: [],
                    boardId: '',

                    // --- Sprints à ignorer ---
                    sprints: [],
                    ignored: [], // liste complète stockée [{ id, name }]
                    savingIgnored: false,
                    ignoredSaved: false,

                    // --- Équipe (roster de la page Capacité) ---
                    members: [], // liste stockée [{ id, name, role, entryDate, exitDate }]
                    savingMembers: false,
                    membersSaved: false,
                    membersError: '',

                    // --- Types de tickets ---
                    issueTypesAvailable: [], // types existants sur le projet (Jira ∪ stockés)
                    issueTypesSelected: [],  // types retenus pour les métriques
                    issueTypesAdded: [],     // types nouvellement ajoutés au global
                    issueTypesLoading: false,
                    savingIssueTypes: false,
                    issueTypesSaved: false,

                    // --- UI ---
                    loading: false,
                    savingBoard: false,
                    boardSaved: false,
                    parentProjectKey: '',
                    savingParent: false,
                    parentSaved: false,
                    parentError: '',
                    releaseTeamName: '',
                    savingReleaseTeam: false,
                    releaseTeamSaved: false,
                    releaseTeamError: '',
                    error: '',

                    /**
                     * Pré-remplit le projet depuis le pool partagé « team » (sélection
                     * faite sur une autre page) pour éviter de le re-rechercher.
                     */
                    init() {
                        const winner = window.jiraStore
                            ? window.jiraStore.read(POOL_KEY)
                            : null;
                        if (winner && winner.project) {
                            this.selectedProject = winner.project;
                            this.query = winner.project.key + ' – ' + winner.project.name;
                            this.loadProjectConfig();
                        }
                    },

                    /** Recherche de projets Jira (réutilise l'API existante). */
                    search() {
                        if (this.query.length < 2) {
                            this.projects = [];
                            return;
                        }
                        fetch('/api/internal/projects/search?q=' + encodeURIComponent(this.query))
                            .then(r => r.json().catch(() => null).then(d => { if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status)); return d; }))
                            .then(data => { this.projects = data; this.open = true; })
                            .catch(err => { this.error = err.message; console.error(err); });
                    },

                    /** Sélection d'un projet → chargement de sa config. */
                    selectProject(project) {
                        this.selectedProject = project;
                        this.query = project.key + ' – ' + project.name;
                        this.open = false;
                        this.error = '';
                        this.boards = [];
                        this.boardId = '';
                        this.boardSaved = false;
                        this.sprints = [];
                        this.ignored = [];
                        this.ignoredSaved = false;
                        this.issueTypesAvailable = [];
                        this.issueTypesSelected = [];
                        this.issueTypesAdded = [];
                        this.parentProjectKey = '';
                        this.parentSaved = false;
                        this.parentError = '';
                        this.releaseTeamName = '';
                        this.releaseTeamSaved = false;
                        this.releaseTeamError = '';
                        // Partage le projet courant avec les autres pages.
                        if (window.jiraStore) {
                            window.jiraStore.write(POOL_KEY, { project: project, boardId: '' });
                        }
                        // Informe la modale de workflow du projet courant (bannière + ciblage).
                        window.dispatchEvent(new CustomEvent('jira:project-changed', { detail: { projectKey: project.key } }));
                        this.loadProjectConfig();
                    },

                    /** Réinitialise la sélection. */
                    reset() {
                        this.selectedProject = null;
                        this.query = '';
                        this.projects = [];
                        this.boards = [];
                        this.boardId = '';
                        this.boardSaved = false;
                        this.sprints = [];
                        this.ignored = [];
                        this.ignoredSaved = false;
                        this.issueTypesAvailable = [];
                        this.issueTypesSelected = [];
                        this.issueTypesAdded = [];
                        this.parentProjectKey = '';
                        this.parentSaved = false;
                        this.parentError = '';
                        this.releaseTeamName = '';
                        this.releaseTeamSaved = false;
                        this.releaseTeamError = '';
                        this.error = '';
                        window.dispatchEvent(new CustomEvent('jira:project-changed', { detail: { projectKey: '' } }));
                    },

                    /**
                     * Redemande boards ET sprints à Jira en ignorant le cache serveur (TTL 12 h).
                     * Utile ici pour voir un board tout juste créé avant de le désigner par défaut.
                     */
                    refreshLists() {
                        this.loadProjectConfig(true);
                    },

                    /**
                     * Charge les boards du projet puis sa config (board par défaut).
                     *
                     * @param {boolean} refresh Ignore le cache serveur des boards et des sprints.
                     */
                    loadProjectConfig(refresh = false) {
                        if (!this.selectedProject) return;
                        const key = this.selectedProject.key;
                        this.loading = true;
                        this.error = '';
                        this.members = [];
                        this.membersSaved = false;
                        this.loadIssueTypes();
                        Promise.all([
                            fetch('/api/internal/projects/' + encodeURIComponent(key) + '/boards'
                                + (refresh ? '?refresh=1' : ''))
                                .then(r => r.json().catch(() => null).then(d => { if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status)); return d; })),
                            fetch('/api/internal/projects/' + encodeURIComponent(key) + '/team-config')
                                .then(r => r.json().catch(() => null).then(d => { if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status)); return d; })),
                        ])
                            .then(([boards, config]) => {
                                if (boards && boards.error) throw new Error(boards.error);
                                this.boards = boards;
                                this.boardId = (config && config.preferredBoardId != null)
                                    ? String(config.preferredBoardId)
                                    : '';
                                this.ignored = (config && Array.isArray(config.ignoredSprints))
                                    ? config.ignoredSprints
                                    : [];
                                this.parentProjectKey = (config && config.parentProjectKey)
                                    ? config.parentProjectKey
                                    : '';
                                // Défaut renvoyé par le backend = projectKey si non configuré.
                                this.releaseTeamName = (config && config.releaseTeamName)
                                    ? config.releaseTeamName
                                    : (this.selectedProject ? this.selectedProject.key : '');
                                this.members = (config && Array.isArray(config.members))
                                    ? config.members
                                    : [];
                                if (this.boardId) {
                                    this.loadSprints(refresh);
                                }
                            })
                            .catch(err => { this.error = err.message; console.error(err); })
                            .finally(() => { this.loading = false; });
                    },

                    /** Persiste la clé du projet parent (Releases & Features) via l'API team-config. */
                    saveParentProject() {
                        if (!this.selectedProject) return;
                        const val = this.parentProjectKey.trim().toUpperCase();
                        this.parentProjectKey = val;
                        this.savingParent = true;
                        this.parentSaved = false;
                        this.parentError = '';
                        const body = new URLSearchParams();
                        body.append('parentProjectKey', val);
                        fetch('/api/internal/projects/' + encodeURIComponent(this.selectedProject.key) + '/team-config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: body.toString(),
                        })
                            .then(r => r.json().then(d => {
                                if (!r.ok || !d.success) throw new Error(d.error || ('HTTP ' + r.status));
                                return d;
                            }))
                            .then(() => {
                                this.parentSaved = true;
                                setTimeout(() => { this.parentSaved = false; }, 3000);
                            })
                            .catch(err => { this.parentError = err.message; console.error(err); })
                            .finally(() => { this.savingParent = false; });
                    },

                    /** Persiste le nom d'équipe filtrant les Releases du projet parent (champ Équipe). */
                    saveReleaseTeam() {
                        if (!this.selectedProject) return;
                        const val = this.releaseTeamName.trim();
                        this.releaseTeamName = val;
                        this.savingReleaseTeam = true;
                        this.releaseTeamSaved = false;
                        this.releaseTeamError = '';
                        const body = new URLSearchParams();
                        body.append('releaseTeamName', val);
                        fetch('/api/internal/projects/' + encodeURIComponent(this.selectedProject.key) + '/team-config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: body.toString(),
                        })
                            .then(r => r.json().then(d => {
                                if (!r.ok || !d.success) throw new Error(d.error || ('HTTP ' + r.status));
                                return d;
                            }))
                            .then(() => {
                                this.releaseTeamSaved = true;
                                setTimeout(() => { this.releaseTeamSaved = false; }, 3000);
                            })
                            .catch(err => { this.releaseTeamError = err.message; console.error(err); })
                            .finally(() => { this.savingReleaseTeam = false; });
                    },

                    /**
                     * Charge les types de tickets du projet (et enrichit le global
                     * des types inédits côté serveur).
                     */
                    loadIssueTypes() {
                        if (!this.selectedProject) return;
                        this.issueTypesLoading = true;
                        this.issueTypesAvailable = [];
                        this.issueTypesSelected = [];
                        this.issueTypesAdded = [];
                        this.issueTypesSaved = false;
                        fetch('/api/internal/projects/' + encodeURIComponent(this.selectedProject.key) + '/issue-types')
                            .then(r => r.json().catch(() => null).then(d => { if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status)); return d; }))
                            .then(d => {
                                if (d && d.error) throw new Error(d.error);
                                this.issueTypesAvailable = d.available || [];
                                this.issueTypesSelected = d.selected || [];
                                this.issueTypesAdded = d.added || [];
                            })
                            .catch(err => { this.error = err.message; console.error(err); })
                            .finally(() => { this.issueTypesLoading = false; });
                    },

                    /** Coche/décoche un type de ticket retenu pour les métriques, puis persiste. */
                    toggleIssueType(type, checked) {
                        if (checked) {
                            if (!this.issueTypesSelected.includes(type)) {
                                this.issueTypesSelected.push(type);
                            }
                        } else {
                            this.issueTypesSelected = this.issueTypesSelected.filter(t => t !== type);
                        }
                        this.saveIssueTypes();
                    },

                    /** Coche tous les types disponibles, puis persiste. */
                    selectAllIssueTypes() {
                        this.issueTypesSelected = this.issueTypesAvailable.slice();
                        this.saveIssueTypes();
                    },

                    /** Décoche tous les types, puis persiste. */
                    selectNoneIssueTypes() {
                        this.issueTypesSelected = [];
                        this.saveIssueTypes();
                    },

                    /** Enregistre la liste des types retenus propre au projet. */
                    saveIssueTypes() {
                        if (!this.selectedProject) return;
                        this.savingIssueTypes = true;
                        this.issueTypesSaved = false;
                        this.error = '';
                        const body = new URLSearchParams();
                        body.append('issueTypes', JSON.stringify(this.issueTypesSelected));
                        fetch('/api/internal/projects/' + encodeURIComponent(this.selectedProject.key) + '/team-config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: body.toString(),
                        })
                            .then(r => r.json().then(d => {
                                if (!r.ok || !d.success) throw new Error(d.error || ('HTTP ' + r.status));
                                return d;
                            }))
                            .then(() => { this.issueTypesSaved = true; })
                            .catch(err => { this.error = err.message; console.error(err); })
                            .finally(() => { this.savingIssueTypes = false; });
                    },

                    /**
                     * Charge les sprints du board sélectionné (pour la liste à ignorer).
                     *
                     * @param {boolean} refresh Ignore le cache serveur des sprints (TTL 12 h).
                     */
                    loadSprints(refresh = false) {
                        if (!this.boardId) { this.sprints = []; return; }
                        fetch('/api/internal/boards/' + encodeURIComponent(this.boardId) + '/sprints'
                            + (refresh ? '?refresh=1' : ''))
                            .then(r => r.json().catch(() => null).then(d => { if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status)); return d; }))
                            .then(data => {
                                if (data && data.error) throw new Error(data.error);
                                this.sprints = data;
                            })
                            .catch(err => { this.error = err.message; console.error(err); });
                    },

                    /** Indique si un sprint est marqué comme ignoré. */
                    isIgnored(sprintId) {
                        return this.ignored.some(s => String(s.id) === String(sprintId));
                    },

                    /** Coche/décoche un sprint à ignorer puis persiste la liste. */
                    toggleIgnore(sprint, checked) {
                        const id = String(sprint.id);
                        if (checked) {
                            if (!this.isIgnored(id)) {
                                this.ignored.push({ id: id, name: sprint.name });
                            }
                        } else {
                            this.ignored = this.ignored.filter(s => String(s.id) !== id);
                        }
                        this.saveIgnored();
                    },

                    /** Enregistre la liste complète des sprints ignorés. */
                    saveIgnored() {
                        if (!this.selectedProject) return;
                        this.savingIgnored = true;
                        this.ignoredSaved = false;
                        this.error = '';
                        const body = new URLSearchParams();
                        body.append('ignoredSprints', JSON.stringify(this.ignored));
                        fetch('/api/internal/projects/' + encodeURIComponent(this.selectedProject.key) + '/team-config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: body.toString(),
                        })
                            .then(r => r.json().then(d => {
                                if (!r.ok || !d.success) throw new Error(d.error || ('HTTP ' + r.status));
                                return d;
                            }))
                            .then(() => { this.ignoredSaved = true; })
                            .catch(err => { this.error = err.message; console.error(err); })
                            .finally(() => { this.savingIgnored = false; });
                    },

                    /** Génère un identifiant stable pour un nouveau membre du roster. */
                    genMemberId() {
                        return 'm' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
                    },

                    /** Ajoute une ligne membre vierge (persistée une fois le nom saisi, côté serveur). */
                    addMember() {
                        this.members.push({ id: this.genMemberId(), name: '', role: 'Dev', entryDate: '', exitDate: '' });
                    },

                    /** Retire un membre du roster puis persiste la liste. */
                    removeMember(idx) {
                        this.members.splice(idx, 1);
                        this.saveMembers();
                    },

                    /** Enregistre le roster complet (les entrées sans nom sont ignorées côté serveur). */
                    saveMembers() {
                        if (!this.selectedProject) return;
                        this.savingMembers = true;
                        this.membersSaved = false;
                        this.membersError = '';
                        const body = new URLSearchParams();
                        body.append('members', JSON.stringify(this.members));
                        fetch('/api/internal/projects/' + encodeURIComponent(this.selectedProject.key) + '/team-config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: body.toString(),
                        })
                            .then(r => r.json().then(d => {
                                if (!r.ok || !d.success) throw new Error(d.error || ('HTTP ' + r.status));
                                return d;
                            }))
                            .then(() => {
                                this.membersSaved = true;
                                setTimeout(() => { this.membersSaved = false; }, 3000);
                            })
                            .catch(err => { this.membersError = err.message; console.error(err); })
                            .finally(() => { this.savingMembers = false; });
                    },

                    /** Enregistre le board par défaut (et inscrit le projet aux projets suivis). */
                    saveBoard() {
                        if (!this.selectedProject) return;
                        this.savingBoard = true;
                        this.boardSaved = false;
                        this.error = '';
                        const body = new URLSearchParams();
                        body.append('preferredBoardId', this.boardId);
                        fetch('/api/internal/projects/' + encodeURIComponent(this.selectedProject.key) + '/team-config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: body.toString(),
                        })
                            .then(r => r.json().then(d => {
                                if (!r.ok || !d.success) throw new Error(d.error || ('HTTP ' + r.status));
                                return d;
                            }))
                            .then(() => { this.boardSaved = true; this.loadSprints(); })
                            .catch(err => { this.error = err.message; console.error(err); })
                            .finally(() => { this.savingBoard = false; });
                    },
                };
            };
        })();
    </script>
</body>

</html>
