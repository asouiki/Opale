<body>
    <?php include __DIR__ . '/../topNavigation.phtml'; ?>

    <div class="card">
        <form method="POST" action="/pi">
            <?php include __DIR__ . '/../components/pi/form/selectJiraProjectOnly.phtml'; ?>

            <div class="pi-form-row">
                <label for="piNumber"><strong>Calculer les métriques du PI n° :</strong></label>
                <input
                    type="text"
                    id="piNumber"
                    name="piNumber"
                    required
                    placeholder="Ex : 8 ou PI8"
