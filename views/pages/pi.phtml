                    class="input" />
                <button type="submit">OK</button>
            </div>
        </form>
    </div>

    <?php include __DIR__ . '/../common/errorMessage.phtml'; ?>

    <?php if ($view): ?>
        <div class="card"
             x-data="piMetrics(<?= htmlspecialchars($view->getFeaturesDetailsAsJson(), ENT_QUOTES) ?>)">
            <h2>
                📊 Cumul des métriques — PI <?= htmlspecialchars($view->getPiNumber()) ?>
                (<?= htmlspecialchars($view->getProjectKey()) ?>)
            </h2>

            <p><em>Décochez une Feature pour l'exclure du cumul.</em></p>

            <table class="pi-features-table">
                <thead>
                    <tr>
                        <th>Inclure</th>
                        <th>Feature</th>
                        <th>Statut</th>
                        <th class="pi-num">Lead Time<?= \App\View\MetricTooltips::render('lead_time') ?></th>
                        <th class="pi-num">Cycle Time<?= \App\View\MetricTooltips::render('cycle_time') ?></th>
                        <!-- <th class="pi-num">Waiting Time</th> -->
                    </tr>
                </thead>
                <tbody>
                    <template x-for="(f, idx) in features" :key="f.key">
                        <tr :class="f.included ? '' : 'row-excluded'">
                            <td><input type="checkbox" x-model="f.included"></td>
                            <td>
                                <a :href="f.url" target="_blank">
                                    <strong x-text="f.key"></strong>
                                </a>
                                — <span x-text="f.name"></span>
                            </td>
                            <td x-text="f.status"></td>
                            <td class="pi-num" x-text="f.leadTime > 0 ? f.leadTime + ' j' : '—'"></td>
                            <td class="pi-num" x-text="f.cycleTime > 0 ? f.cycleTime + ' j' : '—'"></td>
                            <!-- <td class="pi-num" x-text="f.waitingTime > 0 ? f.waitingTime + ' j' : '—'"></td> -->
                        </tr>
                    </template>
                </tbody>
                <tfoot>
                    <tr class="pi-features-table__total">
                        <td colspan="3">
                            Total cumulé (<span x-text="includedCount"></span> Feature(s))
                        </td>
                        <td class="pi-num" x-text="'Lead: ' + totalLead.toFixed(2) + ' j'"></td>
                        <td class="pi-num" x-text="'Cycle: ' + totalCycle.toFixed(2) + ' j'"></td>
                        <!-- <td class="pi-num" x-text="'Wait: ' + totalWait.toFixed(2) + ' j'"></td> -->
                    </tr>
                </tfoot>
            </table>
        </div>

        <script>
            window.piMetrics = function(features) {
                return {
                    features: features.map(f => ({ ...f, included: !f.excluded })),
                    get includedCount() {
                        return this.features.filter(f => f.included).length;
                    },
                    get totalLead() {
                        return this.features.filter(f => f.included).reduce((s, f) => s + (f.leadTime || 0), 0);
                    },
                    get totalCycle() {
                        return this.features.filter(f => f.included).reduce((s, f) => s + (f.cycleTime || 0), 0);
                    },
                    get totalWait() {
                        return this.features.filter(f => f.included).reduce((s, f) => s + (f.waitingTime || 0), 0);
                    },
                };
            };
        </script>
    <?php endif; ?>

