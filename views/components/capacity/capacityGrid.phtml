<?php

/**
 * Grille de capacité de la page /capacity.
 *
 * Reproduit le calcul de capacité d'équipe (auparavant sous Excel) : pour un sprint choisi, une grille
 * lignes = jours ouvrés / colonnes = membres (groupés par rôle), la présence quotidienne, une ligne
 * Événements, un ratio de conversion, et le récap Jours de présence + Capa à faire par rôle.
 *
 * Composant autonome : le projet et le board proviennent du pool partagé « jira_pool_team » (alimenté par
 * /config et la page Métriques d'équipe) ; le roster provient de /config (clé members). Aucune dépendance
 * à une sélection de sprints analysés.
 *
 * Fonctionnalités : sélecteur de sprint → grille jours ouvrés × membres (présence 0 à 1 éditable,
 * 0 grisé hors période du membre ou jour férié) ; lignes Jours présence / Événements / Ratio / Capa à
 * faire ; récap d'équipe (présence + capa par rôle) ; agrégation inter-sprints (PI). Saisie persistée
 * par sprint via l'API capacity (calcul temps réel côté JS).
 */

// Jours fériés (France) connus du projet, convertis de d/m/Y en Y-m-d pour comparaison directe avec les
// dates de la grille. getNonWorkingDays() est mis en cache (fichier) ; en cas d'indisponibilité de l'API
// on dégrade proprement en liste vide (la grille reste utilisable, sans distinction des fériés).
$capacityHolidays = [];
try {
    foreach ((new \App\Model\Config())->getNonWorkingDays() as $frenchDate) {
        $holiday = \DateTime::createFromFormat('d/m/Y', $frenchDate);
        if ($holiday !== false) {
            $capacityHolidays[] = $holiday->format('Y-m-d');
        }
    }
} catch (\Throwable $e) {
    $capacityHolidays = [];
}
$capacityConfig = ['holidays' => $capacityHolidays];
?>

