<?php

/**
 * Composant de sélection Projet + Version OU Release (deux listes déroulantes)
 *
 * @var string $versionsApiEndpoint URL API des Versions du projet (placeholder {key})
 * @var string $releasesApiEndpoint URL API des Releases du projet (placeholder {key})
 * @var string $formAction          Action du formulaire de soumission
 * @var string $inputName           Nom du champ soumis (ID Version OU Key Release)
 * @var string $storageKey          Clé localStorage pour la persistance
 */
?>
<div x-data="jiraProjectWithReleasesSearch()" class="jira-project-search">
    <label for="project-search-<?= htmlspecialchars($storageKey) ?>">
        <strong>Sélectionner mon Projet Jira : </strong>
    </label>

    <div class="project-search-field">
        <input
            id="project-search-<?= htmlspecialchars($storageKey) ?>"
            type="text"
            x-model="query"
            @input.debounce.300ms="search()"
            @focus="open = true"
            class="input-large"
            placeholder="Mon projet"
            autocomplete="off" />

        <div class="project-dropdown"
            x-show="open && projects.length"
            @click.outside="open = false">
            <template x-for="project in projects" :key="project.id">
                <div @click="select(project)" class="hover-bg">
                    <strong x-text="project.key"></strong>
                    <span x-text="' – ' + project.name"></span>
                </div>
            </template>
        </div>
    </div>

    <label class="persist-toggle">
        <input type="checkbox" x-model="persistShared">
        Persister cette sélection sur les autres pages (Release / Sprint / Métriques / Planification)
    </label>

    <div x-show="selected">
        <div class="jira-project-selected">
            ✅ Projet sélectionné : <strong x-text="selected?.key"></strong>
            <button type="button" @click="reset()" class="jira-project-reset-btn">
                🔄 Changer de projet
            </button>
        </div>

        <div class="jira-selector-row">
            <!-- Dropdown 1 : Releases (issues de type Release) -->
            <div class="jira-selector-col">
                <form method="POST" action="<?= htmlspecialchars($formAction) ?>">
                    <label><strong>Sélectionner une Release :</strong></label>
                    <input type="hidden" name="projectKey" :value="selected?.key">
                    <select
                        name="<?= htmlspecialchars($inputName) ?>"
                        class="input"
                        @change="$el.form.requestSubmit()">
                        <option value="" disabled selected>-- Choisir une Release --</option>
                        <template x-for="item in releases" :key="'r-' + item.key">
                            <option :value="item.key" x-text="item.label"></option>
                        </template>
                    </select>
                </form>
                <div x-show="!releasesLoading && releases.length === 0 && !releasesError"
                    class="jira-selector-empty">
                    ⚠️ Aucune Release trouvée pour ce projet
                </div>
                <div x-show="releasesLoading" aria-busy="true">⏳ Chargement Releases…</div>
                <div x-show="releasesError" class="inline-error">❌ <span x-text="releasesError"></span></div>
            </div>

            <!-- Dropdown 2 : Versions du projet -->
            <div class="jira-selector-col">
                <form method="POST" action="<?= htmlspecialchars($formAction) ?>">
                    <label><strong>Sélectionner une Version :</strong></label>
                    <input type="hidden" name="projectKey" :value="selected?.key">
                    <select
                        name="<?= htmlspecialchars($inputName) ?>"
                        class="input"
                        @change="$el.form.requestSubmit()">
                        <option value="" disabled selected>-- Choisir une Version --</option>
                        <template x-for="item in versions" :key="'v-' + item.id">
                            <option :value="item.id" x-text="item.label"></option>
                        </template>
                    </select>
                </form>
                <div x-show="!versionsLoading && versions.length === 0 && !versionsError"
                    class="jira-selector-empty">
                    ⚠️ Aucune Version trouvée pour ce projet
                </div>
                <div x-show="versionsLoading" aria-busy="true">⏳ Chargement Versions…</div>
                <div x-show="versionsError" class="inline-error">❌ <span x-text="versionsError"></span></div>
            </div>
        </div>

        <div x-show="error" class="inline-error">❌ <span x-text="error"></span></div>
    </div>
</div>

<script>
    (function() {
        const VERSIONS_API_ENDPOINT = <?= json_encode($versionsApiEndpoint) ?>;
        const RELEASES_API_ENDPOINT = <?= json_encode($releasesApiEndpoint) ?>;
        const LOCAL_KEY = <?= json_encode($storageKey) ?>;
        const POOL_KEY = 'jira_pool_team';
        const FORCED_PROJECT_KEY = <?= json_encode($forcedProjectKey ?? '') ?>;

        window.jiraProjectWithReleasesSearch = function() {
            return {
                query: '',
                open: false,
                projects: [],
                selected: null,
                loading: false,
                error: null,
                versions: [],
                versionsLoading: false,
                versionsError: null,
                releases: [],
                releasesLoading: false,
                releasesError: null,

                /** Propage la sélection au pool « team » (cochée par défaut). */
                persistShared: true,

                /**
                 * Restaure la sélection la plus récente entre la clé locale de la
                 * page et la clé partagée du pool « team », puis recharge versions
                 * et releases (non mises en cache : toujours refetch).
                 */
                init() {
                    // Deep-link « Analyse » : le projet de la Release prime sur la sélection persistée,
                    // pour aligner le sélecteur sur la Release affichée (sans écraser le pool partagé).
                    if (FORCED_PROJECT_KEY) {
                        this.preselectByKey(FORCED_PROJECT_KEY);
                        return;
                    }

                    const winner = window.jiraStore.mostRecent(
                        window.jiraStore.read(LOCAL_KEY),
                        window.jiraStore.read(POOL_KEY)
                    );
                    if (winner && winner.project) {
                        this.selected = winner.project;
                        this.query = winner.project.key + ' – ' + winner.project.name;
                        this.loadVersions();
                        this.loadReleases();
                    }
                },

                /**
                 * Résout un projet par sa clé exacte via l'autocomplete puis le sélectionne, afin de
                 * charger ses Versions/Releases. Ne persiste pas (sélection contextuelle au deep-link).
                 */
                preselectByKey(key) {
                    fetch('/api/internal/projects/search?q=' + encodeURIComponent(key))
                        .then(r => r.ok ? r.json() : [])
                        .then(list => {
                            const match = (list || []).find(p => p.key === key);
                            if (!match) return;
                            this.selected = match;
                            this.query = match.key + ' – ' + match.name;
                            this.loadVersions();
                            this.loadReleases();
                        })
                        .catch(err => console.error(err));
                },

                /**
                 * Persiste la sélection : toujours en local, et dans le pool « team »
                 * uniquement si la case « Persister » est cochée. Le board partagé
                 * est remis à null car il appartenait au projet précédent : Sprint
                 * et Planification le re-détecteront pour le nouveau projet.
                 */
                _saveToStorage() {
                    window.jiraStore.write(LOCAL_KEY, { project: this.selected });
                    if (this.persistShared) {
                        window.jiraStore.write(POOL_KEY, { project: this.selected, boardId: null });
                    }
                },

                reset() {
                    this.selected = null;
                    this.versions = [];
                    this.releases = [];
                    this.query = '';
                    this.projects = [];
                    this.error = null;
                    this.versionsError = null;
                    this.releasesError = null;
                    window.jiraStore.remove(LOCAL_KEY);
                    if (this.persistShared) {
                        window.jiraStore.remove(POOL_KEY);
                    }
                },

                search() {
                    if (this.query.length < 2) {
                        this.projects = [];
                        return;
                    }
                    this.loading = true;
                    fetch('/api/internal/projects/search?q=' + encodeURIComponent(this.query))
                        .then(r => r.json().catch(() => null).then(d => {
                            if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status));
                            return d;
                        }))
                        .then(data => {
                            this.projects = data;
                            this.open = true;
                        })
                        .catch(err => {
                            this.error = err.message;
                            console.error(err);
                        })
                        .finally(() => {
                            this.loading = false;
                        });
                },

                select(project) {
                    this.selected = project;
                    this.query = project.key + ' – ' + project.name;
                    this.open = false;
                    this._saveToStorage();
                    this.loadVersions();
                    this.loadReleases();
                },

                loadVersions() {
                    this.versionsLoading = true;
                    this.versionsError = null;
                    this.versions = [];

                    const url = VERSIONS_API_ENDPOINT.replace('{key}', this.selected.key);

                    fetch(url)
                        .then(r => r.json().catch(() => null).then(d => {
                            if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status));
                            return d;
                        }))
                        .then(data => {
                            this.versions = data;
                        })
                        .catch(err => {
                            this.versionsError = err.message;
                            console.error(err);
                        })
                        .finally(() => {
                            this.versionsLoading = false;
                        });
                },

                loadReleases() {
                    this.releasesLoading = true;
                    this.releasesError = null;
                    this.releases = [];

                    const url = RELEASES_API_ENDPOINT.replace('{key}', this.selected.key);

                    fetch(url)
                        .then(r => r.json().catch(() => null).then(d => {
                            if (!r.ok) throw new Error((d && d.error) || ('HTTP ' + r.status));
                            return d;
                        }))
                        .then(data => {
                            this.releases = data;
                        })
                        .catch(err => {
                            this.releasesError = err.message;
                            console.error(err);
                        })
                        .finally(() => {
                            this.releasesLoading = false;
                        });
                },
            };
        };
    })();
</script>