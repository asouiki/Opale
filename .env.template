# Remplacer ces infos exemples par les votres
JIRA_BASE_URL=https://votre-entreprise.atlassian.net
JIRA_EMAIL=email@entreprise.com
JIRA_API_TOKEN=votre_token_api_jira

# Desactive la verification SSL des appels API, ne mettre true seulement sur les environnements de démo !
IS_DEMO=false

# Local LLM
LLM_ENABLED  = false        # false = fonctionnalité entièrement désactivée et masquée (UI + API). Pour l'activer, voir README_INSTALL_LOCAL_LLM.md
LLM_BASE_URL = http://localhost:11434/v1
LLM_API_KEY  = ollama       # factice, Ollama ne vérifie pas
LLM_MODEL    = qwen2.5:14b

# Secure reboot (option.)
REBOOT_TOKEN=


