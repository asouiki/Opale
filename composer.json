{
    "require": {
        "php": "^8.5",
        "slim/slim": "^4.15.2",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "phpstan/phpstan": "2.2.5",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@test",
            "@stan",
            "@cs"
        ]
    }
}
